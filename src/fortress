#!/usr/bin/env bash

AGENT="${1:-opencode}"

case "$AGENT" in
  opencode|claude|codex|cmd)
    ;;
  *)
    echo "Unknown agent: $AGENT"
    echo "Usage: fortress [opencode|claude|codex|cmd]"
    exit 1
    ;;
esac

PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR" | tr -cd 'a-zA-Z0-9_-')"

case "$AGENT" in
  codex)
    CONTAINER_CMD=(codex --sandbox danger-full-access --ask-for-approval never)
    ;;
  cmd)
    CONTAINER_CMD=(/bin/bash)
    ;;
  *)
    CONTAINER_CMD=("$AGENT")
    ;;
esac

docker run --rm -it \
  --name "fortress-${PROJECT_NAME}" \
  -v "$PROJECT_DIR":/workspace:rw \
  -w /workspace \
  --tmpfs /tmp:exec \
  -v fortress_home:/home/fortress \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --pids-limit 256 \
  --memory=2g \
  --add-host=host.docker.internal:host-gateway \
  --env-file "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.env" \
  fortress "${CONTAINER_CMD[@]}"
